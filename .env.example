# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables (Production + Preview).
# Full guide: docs/DEPLOY-VERCEL.md

# Canonical site URL (Open Graph, sitemap, emails). On Vercel production, set to your
# custom domain, e.g. https://novacity.example.com
# If unset on Vercel, previews use https://${VERCEL_URL} automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required — JWT sessions (24+ characters). Generate: openssl rand -base64 32
AUTH_SECRET=

# Required — MongoDB Atlas or compatible URI. For Vercel, allow serverless egress
# (Atlas Network Access: 0.0.0.0/0 or Vercel IP ranges).
MONGODB_URI=

# Vercel sets VERCEL=1 and VERCEL_URL automatically (do not add manually).

# Cloudinary — required on Vercel for file uploads (listings, profile, hero, verification).
# Either CLOUDINARY_URL or the three variables below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_UPLOAD_FOLDER=novacity/listings
# CLOUDINARY_PROFILE_UPLOAD_FOLDER=novacity/profiles

# Transactional email (owner verification approval) — https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=Novacity <notifications@your-domain.com>

# Admin seed — run locally only: npm run seed:admin (never enable on Vercel env)
# ALLOW_ADMIN_SEED=true
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=use-a-strong-password-here
# SEED_ADMIN_NAME=Site Owner
